# Copy to .env. Never commit API keys, passwords, or real connection URLs.
OPENAI_API_KEY=
# Replace if needed with another model supporting Responses structured outputs.
OPENAI_MODEL=gpt-4.1-mini

# Local Docker database used by default. Pass --no-db for file-only runs.
# Choose your own password before the first database startup.
# Put its URL-encoded form in DATABASE_URL. These values must match.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://daily_tech:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:5432/daily_tech
